# Database connection settings (secrets not committed)
# Copy this file to .env and fill in real values

SQL_SERVER=
SQL_DATABASE=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH_MODE=sql_password
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no

# For Entra service principal auth (alternative to SQL password)
# SQL_AUTH_MODE=entra_service_principal
# SQL_TENANT_ID=
# SQL_CLIENT_ID=
# SQL_CLIENT_SECRET=
